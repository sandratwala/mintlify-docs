        "pages": ["docs/frontend-web", "docs/mobile"]
      },
      {
        "group": "Development",
        "pages": ["docs/code-standards", "docs/deployment", "docs/qa"]
      },
      {
        "group": "Reference",
        "pages": ["docs/glossary"]
      }
