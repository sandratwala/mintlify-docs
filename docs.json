{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Probe Docs",
  "colors": {
    "primary": "#0D9488",
    "light": "#075E54",
    "dark": "#111827"
  },
  "redirects": [
    { "source": "/", "destination": "/docs/index" }
  ],
  "navigation": {
